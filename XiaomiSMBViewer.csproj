<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XiaomiSMBViewer</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Xiaomi SMB Viewer</Product>
    <Description>Single-timeline viewer for per-minute Xiaomi camera recordings on an SMB share</Description>
    <Copyright>Copyright (c) 2026 tramix32</Copyright>
    <RootNamespace>XiaomiSMBViewer</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon />
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- WinForms jest wciagane tylko przez LibVLCSharp.WPF (VideoView).
       Jego globalne usingi kolidowalyby z typami WPF (Color, Brush, Point, ...). -->
  <ItemGroup>
    <Content Include="Locales\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- VideoLAN.LibVLC.Windows kopiuje libvlc dla obu architektur niezaleznie od RID.
       Przy publishu pod win-x64 wariant x86 to okolo 100 MB smiecia; .lib to biblioteki
       importu potrzebne tylko przy linkowaniu, nie w czasie dzialania. -->
  <Target Name="TrimUnusedVlcFiles" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <VlcJunk Include="$(PublishDir)libvlc\win-x86\**\*" />
      <VlcJunk Include="$(PublishDir)libvlc\win-x64\*.lib" />
    </ItemGroup>
    <Delete Files="@(VlcJunk)" />
    <RemoveDir Directories="$(PublishDir)libvlc\win-x86" />
  </Target>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.9.4" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.4" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

</Project>
